{
  "manifest_version": 3,
  "name": "Interceptor - HTTP & API Testing",
  "short_name": "Interceptor",
  "version": "1.1.1",
  "description": "Inspect browser traffic, test APIs, review security evidence, and save requests, history, and encrypted backups locally.",
  "permissions": [
    "debugger",
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Interceptor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
